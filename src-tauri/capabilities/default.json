{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "skillsmp-proxy"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:default",
    "core:window:default",
    "opener:default",
    "dialog:default",
    "updater:default",
    "process:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://skillsmp.com/*" },
        { "url": "https://*.skillsmp.com/*" },
        { "url": "https://github.com/*" }
      ]
    }
  ]
}
